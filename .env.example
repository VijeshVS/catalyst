# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# PostgreSQL
POSTGRES_USER=catalyst
POSTGRES_PASSWORD=catalyst
POSTGRES_DB=catalyst_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://catalyst:catalyst@localhost:5432/catalyst_db

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
