  "cards": [
    {
      "dot": "cyan",
      "title": "Nothing is auto-provisioned",
      "items": [
        "There is no default organization or project. Both are explicitly created, and a user may own many organizations.",
        "Creating a project is the only place the standard dev, staging, and prod environments appear, and it happens in the same transaction as the project."
      ]
    },
    {
      "dot": "emerald",
      "title": "Tenancy is enforced, not assumed",
      "items": [
        "Organization.owner_id is the ownership boundary, and every project, environment, and flag lookup is filtered through it.",
        "A missing resource and an inaccessible one both answer 404, so IDs cannot be enumerated by probing."
      ]
    }
  ]
