          "steady"
        ],
        "note": "The ordinary cycle: read conditionally on every check, then decide locally."
      },
      {
        "id": "recovery",
        "label": "Recovery",
        "focus": [
          "refreshing",
          "backoff"
        ],
        "note": "A failed read opens a time-based backoff window, then returns to the read path."
      },
      {
        "id": "terminal",
        "label": "Terminal",
        "focus": [
          "refreshing",
          "rejected"
        ],
        "note": "The one failure that will not fix itself, because a rejected key never becomes valid again."
      }
    ]
  },
  "lanes": [
