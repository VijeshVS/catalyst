  "cards": [
    {
      "dot": "cyan",
      "title": "Reads as it evaluates",
      "items": [
        "Construction performs no I/O, so the client can be built at import time without a network call.",
        "Every check sends the current ETag as If-None-Match, which is what makes a dashboard toggle visible on the very next check."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is absorbed on purpose",
      "items": [
        "A flag check sits inside someone else's request, so a read failure degrades to the last good snapshot instead of raising.",
        "A failed read opens a failure_backoff window, so an unreachable API costs one timeout per window rather than one per check."
      ]
    }
  ]
}